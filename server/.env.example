# ---------------------------------------------------------------
# Medicar server configuration. Copy to server/.env and adjust.
# Never commit the real .env file.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL. Examples:
#   Unix socket (peer auth): postgresql:///medicar_dev?host=/var/run/postgresql
#   TCP:                     postgresql://medicar:medicar@localhost:5432/medicar_dev
DATABASE_URL=postgresql:///medicar_dev?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql:///medicar_test?host=/var/run/postgresql
# Per-connection safety limits in milliseconds (0 disables): longest query,
# longest wait for a locked row, longest idle open transaction.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Largest report export in rows; bigger exports are refused (narrow the dates) rather than cut short.
EXPORT_MAX_ROWS=100000

# Origin of the React app (used for CORS-free dev proxy checks and email links)
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Business calendar used for "today", expiry, and report date boundaries
BUSINESS_TIMEZONE=Africa/Addis_Ababa

# Security
SESSION_COOKIE_NAME=medicar_sid
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_SETUP_TTL_HOURS=72
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Set to 1 when running behind a reverse proxy (needed for correct client IPs and Secure cookies)
TRUST_PROXY=0

# Optional SMTP. When SMTP_HOST is empty, emails (reset/setup links) are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Medicar <no-reply@example.com>"
